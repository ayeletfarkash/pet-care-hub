# Copy to .env.local for local overrides. All values are optional in development.

# SQLite database file (libsql URL). Default: file:./data/app.db
DATABASE_URL=file:./data/app.db

# Folder for uploaded pet photos (outside public/; served only to group members). Default: ./data/uploads
UPLOAD_DIR=./data/uploads

# Public base URL used in invitation and password reset links and for Google sign-in. REQUIRED in production.
APP_URL=http://localhost:3000

# Shown on the accessibility statement page. Leave empty until a real contact exists.
ACCESSIBILITY_CONTACT_EMAIL=

# Password reset emails. Without it, development prints the reset link to the server console and production disables reset.
# Gmail: create an app password (needs 2-step verification) at https://myaccount.google.com/apppasswords and write @ as %40:
# SMTP_URL=smtps://you%40gmail.com:your-app-password@smtp.gmail.com
SMTP_URL=

# "Continue with Google". The button is hidden until both are set. Setup steps: docs/development.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web Push (phone notifications). Optional: without them, reminders only appear in the in-app inbox.
# Generate once with: npx web-push generate-vapid-keys   — keep the private key secret, never commit it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=
