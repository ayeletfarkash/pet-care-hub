# Copy to .env.local for local overrides. All values are optional in development.

# SQLite database file (libsql URL). Default: file:./data/app.db
DATABASE_URL=file:./data/app.db

# Folder for uploaded pet photos (outside public/; served only to group members). Default: ./data/uploads
UPLOAD_DIR=./data/uploads

# Public base URL used in invitation links. REQUIRED in production (otherwise the Host header is used).
APP_URL=http://localhost:3000

# Shown on the accessibility statement page. Leave empty until a real contact exists.
ACCESSIBILITY_CONTACT_EMAIL=
